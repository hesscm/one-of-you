{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(node scripts/forum.mjs:*)",
      "Bash(node scripts/seal.mjs:*)",
      "Bash(sha256sum:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(.secrets)",
      "Read(./.secrets)"
    ]
  }
}
